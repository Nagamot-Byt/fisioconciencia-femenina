    <!-- LIGHTBOX -->
    <div id="lightbox-modal" class="fixed inset-0 bg-ebano/90 backdrop-blur-md z-50 hidden flex items-center justify-center p-4" onclick="closeLightbox()">
        <div class="max-w-4xl w-full relative" onclick="event.stopPropagation()">
            <button onclick="closeLightbox()" class="absolute -top-12 right-0 text-white hover:text-oro-brillo p-2 focus:outline-none">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <img id="lightbox-img" src="" alt="Imagen ampliada" class="w-full h-auto max-h-[80vh] object-contain rounded-2xl border-2 border-oro-ancestral shadow-2xl">
            <p id="lightbox-caption" class="text-center text-oro-suave font-titulo text-sm mt-4 font-semibold"></p>
        </div>
    </div>

    <script>
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileBtn.addEventListener('click', () => {
            const isHidden = mobileMenu.classList.toggle('hidden');
            mobileBtn.setAttribute('aria-expanded', !isHidden);
        });

        const phasesData = {
            fase1: {
                title: "Fase 1: Preparación y Mapeo Comunitario",
                badge: "Fundamentación y Territorio",
                content: `
                    <div class="space-y-4 text-ebano font-cuerpo">
                        <p class="text-base leading-relaxed">
                            Mapeo comunitario a pie en el corregimiento de <strong>San Isidro (Jamundí)</strong>, entablando diálogo participativo con lideresas de la Junta de Acción Comunal y matronas locales.
                        </p>
                        <div class="bg-white p-5 rounded-2xl border border-terracota/10 shadow-sm flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl bg-terracota text-oro-brillo flex items-center justify-center shrink-0">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                            </div>
                            <div>
                                <h4 class="font-titulo font-bold text-terracota">Elaboración de "El Baúl Viajero"</h4>
                                <p class="text-sm text-piedra-clara mt-1">Diseño y prototipado de material didáctico portable, confeccionado con materiales locales (telas, papel kraft, fibras de plátano y siluetas anatómicas reciclables).</p>
                            </div>
                        </div>
                    </div>
                `
            },
            fase2: {
                title: "Fase 2: Educación Anatómica Participativa",
                badge: "Salud & Morfofisiología",
                content: `
                    <div class="grid md:grid-cols-2 gap-6 text-ebano font-cuerpo">
                        <div class="bg-white p-5 rounded-2xl border border-verde-pacifico/20 shadow-sm">
                            <span class="text-xs font-titulo font-bold uppercase tracking-wider text-verde-pacifico bg-verde-hoja px-3 py-1 rounded-full">Niñas (5-9 años)</span>
                            <h4 class="font-titulo font-bold text-terracota mt-3 mb-2">Dinámica "Detective de mi Cuerpo"</h4>
                            <p class="text-sm text-piedra-clara">Siluetas anatómicas a escala real, juego "El cuerpo de trapo" y cuentacuentos con títeres para nombrar las partes del cuerpo con naturalidad y respeto.</p>
                        </div>
                        <div class="bg-white p-5 rounded-2xl border border-oro-ancestral/30 shadow-sm">
                            <span class="text-xs font-titulo font-bold uppercase tracking-wider text-terracota bg-oro-suave px-3 py-1 rounded-full">Adolescentes (10-14 años)</span>
                            <h4 class="font-titulo font-bold text-terracota mt-3 mb-2">Rotafolio de Pubertad y Menstruación</h4>
                            <p class="text-sm text-piedra-clara">Buzón de dudas anónimas para resolver mitos menstruales, elaboración de kits de higiene digna e información sobre el ciclo biológico.</p>
                        </div>
                    </div>
                `
            },
            fase3: {
                title: "Fase 3: Conexión Mente-Cuerpo y Autocuidado",
                badge: "Bienestar Emocional & Matronato",
                content: `
                    <div class="grid md:grid-cols-2 gap-6 text-ebano font-cuerpo">
                        <div class="bg-white p-5 rounded-2xl border border-verde-pacifico/20 shadow-sm">
                            <span class="text-xs font-titulo font-bold uppercase tracking-wider text-verde-pacifico bg-verde-hoja px-3 py-1 rounded-full">Niñas</span>
                            <h4 class="font-titulo font-bold text-terracota mt-3 mb-2">"La Burbuja de Jabón" & Yoga Lúdico</h4>
                            <p class="text-sm text-piedra-clara">Ejercicios respiratorios para la autorregulación emocional, posturas de conciencia corporal y amuleto simbólico de la autoestima.</p>
                        </div>
                        <div class="bg-white p-5 rounded-2xl border border-oro-ancestral/30 shadow-sm">
                            <span class="text-xs font-titulo font-bold uppercase tracking-wider text-terracota bg-oro-suave px-3 py-1 rounded-full">Adolescentes</span>
                            <h4 class="font-titulo font-bold text-terracota mt-3 mb-2">Círculo de la Palabra & Turbantes</h4>
                            <p class="text-sm text-piedra-clara">Espacio seguro para compartir historias corporales, redacción de cartas de apreciación al propio cuerpo y taller ceremonial de amarre de turbante.</p>
                        </div>
                    </div>
                `
            },
            fase4: {
                title: "Fase 4: Evaluación e Impacto Comunitario",
                badge: "Resultados & Sistematización",
                content: `
                    <div class="space-y-4 text-ebano font-cuerpo">
                        <div class="bg-white p-5 rounded-2xl border border-terracota/10 shadow-sm flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl bg-verde-pacifico text-oro-brillo flex items-center justify-center shrink-0">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <div>
                                <h4 class="font-titulo font-bold text-terracota">Evaluación Pre y Post Taller</h4>
                                <p class="text-sm text-piedra-clara mt-1">Medición cuantitativa y cualitativa del incremento de conocimientos anatómicos y reducción del tabú corporal en las participantes.</p>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl border border-terracota/10 shadow-sm flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl bg-oro-ancestral text-terracota-oscura flex items-center justify-center shrink-0">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </div>
                            <div>
                                <h4 class="font-titulo font-bold text-terracota">Mural Colectivo de Huellas</h4>
                                <p class="text-sm text-piedra-clara mt-1">Creación artística en el espacio comunitario como cierre simbólico de empoderamiento y compromiso de autocuidado continuado.</p>
                            </div>
                        </div>
                    </div>
                `
            }
        };

        const tabContainer = document.getElementById('tabs-container');
        const tabContent = document.getElementById('tab-content');

        function updateTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => {
                const isActive = btn.dataset.tab === tabId;
                btn.setAttribute('aria-selected', isActive);
                if (isActive) {
                    btn.classList.add('active', 'bg-verde-pacifico', 'text-white');
                    btn.classList.remove('bg-arena', 'text-terracota');
                } else {
                    btn.classList.remove('active', 'bg-verde-pacifico', 'text-white');
                    btn.classList.add('bg-arena', 'text-terracota');
                }
            });

            const data = phasesData[tabId];
            tabContent.innerHTML = `
                <div class="space-y-4">
                    <span class="text-xs font-titulo font-bold uppercase tracking-wider text-terracota bg-terracota-claro px-3 py-1 rounded-full border border-terracota/20">${data.badge}</span>
                    <h3 class="text-2xl sm:text-3xl font-titulo font-bold text-terracota">${data.title}</h3>
                    ${data.content}
                </div>
            `;
        }

        tabContainer.addEventListener('click', (e) => {
            const btn = e.target.closest('.tab-btn');
            if (btn) {
                updateTab(btn.dataset.tab);
            }
        });

        updateTab('fase1');

        const counters = document.querySelectorAll('.counter');
        let animated = false;

        function animateCounters() {
            if (animated) return;
            animated = true;
            counters.forEach(counter => {
                const target = +counter.getAttribute('data-target');
                let count = 0;
                const speed = Math.max(20, Math.floor(2000 / target));

                const updateCount = () => {
                    if (count < target) {
                        count += Math.ceil(target / 40);
                        if (count > target) count = target;
                        counter.innerText = count;
                        setTimeout(updateCount, speed);
                    } else {
                        counter.innerText = target;
                    }
                };
                updateCount();
            });
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    if (entry.target.querySelector('.counter')) {
                        animateCounters();
                    }
                }
            });
        }, { threshold: 0.15 });

        document.querySelectorAll('.fade-in-up').forEach(el => observer.observe(el));

        const modal = document.getElementById('resource-modal');
        const modalContent = document.getElementById('modal-content');

        function openResourceModal(type) {
            document.body.classList.add('modal-active');
            modal.classList.remove('hidden');

            if (type === 'ninas') {
                modalContent.innerHTML = `
                    <span class="text-xs font-titulo font-bold uppercase tracking-wider text-verde-pacifico bg-verde-hoja px-3 py-1 rounded-full">Niñas 5 a 9 años</span>
                    <h3 class="text-2xl font-titulo font-bold text-terracota">Guía: Mi cuerpo, mi tesoro</h3>
                    <p class="text-sm text-ebano font-cuerpo leading-relaxed">
                        Documento ilustrado diseñado para el reconocimiento anatómico primario, desarrollo de la autonomía personal y autocuidado en la infancia.
                    </p>
                    <div class="bg-arena p-4 rounded-xl text-xs space-y-2 font-cuerpo">
                        <p><strong>Formato:</strong> PDF interactivo listo para impresión</p>
                        <p><strong>Contenido:</strong> Cuentacuentos, hojas de colorear anatómicas y guía para facilitadores.</p>
                    </div>
                    <a href="#descarga" onclick="confirmDownload('Mi cuerpo, mi tesoro')" class="w-full bg-verde-pacifico text-white font-titulo font-bold uppercase text-xs tracking-wider py-3.5 rounded-xl block text-center shadow hover:bg-verde-selva transition">
                        Confirmar Descarga PDF
                    </a>
                `;
            } else {
                modalContent.innerHTML = `
                    <span class="text-xs font-titulo font-bold uppercase tracking-wider text-terracota bg-oro-suave px-3 py-1 rounded-full">Adolescentes 10 a 14 años</span>
                    <h3 class="text-2xl font-titulo font-bold text-terracota">Guía: Conociendo mi cuerpo</h3>
                    <p class="text-sm text-ebano font-cuerpo leading-relaxed">
                        Manual pedagógico para la adolescencia enfocado en la morfofisiología puberal, higiene menstrual digna y fortalecimiento de la autoestima afrocolombiana.
                    </p>
                    <div class="bg-arena p-4 rounded-xl text-xs space-y-2 font-cuerpo">
                        <p><strong>Formato:</strong> PDF interactivo ilustrado</p>
                        <p><strong>Contenido:</strong> Diagramas anatómicos, calendario menstrual y relatos ancestrales.</p>
                    </div>
                    <a href="#descarga" onclick="confirmDownload('Conociendo mi cuerpo')" class="w-full bg-oro-ancestral text-terracota-oscura font-titulo font-bold uppercase text-xs tracking-wider py-3.5 rounded-xl block text-center shadow hover:bg-oro-brillo transition">
                        Confirmar Descarga PDF
                    </a>
                `;
            }
        }

        function closeResourceModal() {
            document.body.classList.remove('modal-active');
            modal.classList.add('hidden');
        }

        function confirmDownload(title) {
            alert('Iniciando descarga del recurso didáctico: "' + title + '".');
            closeResourceModal();
        }

        const lightboxModal = document.getElementById('lightbox-modal');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCaption = document.getElementById('lightbox-caption');

        function openLightbox(src, caption) {
            lightboxImg.src = src;
            lightboxCaption.innerText = caption;
            lightboxModal.classList.remove('hidden');
        }

        function closeLightbox() {
            lightboxModal.classList.add('hidden');
        }

        function handleContactSubmit(e) {
            e.preventDefault();
            const alertBox = document.getElementById('contact-alert');
            alertBox.innerText = "¡Gracias por contactarnos! Tu mensaje ha sido enviado exitosamente al equipo del proyecto.";
            alertBox.classList.remove('hidden');
            document.getElementById('contact-form').reset();
            setTimeout(() => alertBox.classList.add('hidden'), 5000);
        }
    </script>
</body>
</html>
