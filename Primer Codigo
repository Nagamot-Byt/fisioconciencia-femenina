    <!-- MODAL RECURSOS -->
    <div id="resource-modal" class="fixed inset-0 bg-ebano/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-8 shadow-2xl relative border-2 border-oro-ancestral">
            <button onclick="closeResourceModal()" class="absolute top-4 right-4 text-piedra-clara hover:text-terracota p-2 rounded-full focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
